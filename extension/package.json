{
  "name": "dopaqueue-extension",
  "version": "0.2.0",
  "description": "DopaQueue Chrome Extension - Save videos intentionally, watch them distraction-free",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node ../../verify.js",
    "test:watch": "node ../../verify.js --watch",
    "clean": "rm -rf dist",
    "package": "npm run build && node scripts/package-zip.js"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "archiver": "^8.0.0",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chrome-extension",
    "productivity",
    "youtube",
    "video-saver",
    "dopamine",
    "focus"
  ],
  "author": "DopaQueue Team",
  "license": "MIT",
  "homepage": "https://github.com/contactbitwiselabs-max/Dopaqueue",
  "repository": {
    "type": "git",
    "url": "https://github.com/contactbitwiselabs-max/Dopaqueue"
  },
  "bugs": {
    "url": "https://github.com/contactbitwiselabs-max/Dopaqueue/issues"
  }
}
